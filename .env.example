# ============================================================
# crewai-mcp-lead-gen-agents — Environment Configuration
# ============================================================
# cp .env.example .env

# LLM — Google Gemini (free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------
# Vinkius MCP Server URLs (only 5 needed)
# URL format: https://edge.vinkius.com/<your_token>/mcp
# Get yours at: https://vinkius.com
# -----------------------------------------------------------

# Agent 1 — Lead Researcher
VINKIUS_APOLLOIO_MCP_URL=https://edge.vinkius.com/vk_live_REPLACE_ME/mcp
VINKIUS_CRUNCHBASE_MCP_URL=https://edge.vinkius.com/vk_live_REPLACE_ME/mcp

# Agent 2 — Contact Enrichment
VINKIUS_HUNTER_MCP_URL=https://edge.vinkius.com/vk_live_REPLACE_ME/mcp
VINKIUS_LINKEDIN_MCP_URL=https://edge.vinkius.com/vk_live_REPLACE_ME/mcp

# Optional, operator-owned wallet for Jarvis's x402 pre-enrichment gate.
# Without it, the gate performs only an unpaid 402 discovery proof and fails
# closed before Hunter/LinkedIn. Never commit or share this key.
JARVIS_X402_EVM_PRIVATE_KEY=

# Agent 3 — Outreach Strategist
VINKIUS_EXA_MCP_URL=https://edge.vinkius.com/vk_live_REPLACE_ME/mcp
